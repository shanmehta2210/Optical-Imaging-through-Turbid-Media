# Later raw sessions stay out of git. Tracked dates are stored as-is;
# each TIFF under data/raw goes through Git LFS.
data/raw/*
!data/raw/.gitkeep
!data/raw/20261007/
!data/raw/20261007/**
!data/raw/20261014/
!data/raw/20261014/**
!data/raw/20261027/
!data/raw/20261027/**
!data/raw/20261028/
!data/raw/20261028/**
!data/raw/20261029/
!data/raw/20261029/**

# Simulation outputs.
runs/*
!runs/.gitkeep

# Python build and bytecode.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/

# Virtual environments.
.venv/
venv/
env/
ENV/
