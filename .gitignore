# Later raw sessions stay out of git. The 2026-10-07 water-reference
# stacks are tracked; each TIFF is stored with Git LFS.
data/raw/*
!data/raw/.gitkeep
!data/raw/20261007/
!data/raw/20261007/**

# Simulation outputs.
runs/*
!runs/.gitkeep

# Python build and bytecode.
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/

# Virtual environments.
.venv/
venv/
env/
ENV/
